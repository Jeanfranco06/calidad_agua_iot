#ifndef CONFIG_H
#define CONFIG_H

// =============================================================================
// CONFIGURACIÓN DEL NODO FÍSICO ESP32 (PLANTILLA EJEMPLO)
// Copiar este archivo como "config.h" y completar con sus credenciales de red.
// NUNCA subir "config.h" con credenciales reales a repositorios públicos.
// =============================================================================

// 1. Red Wi-Fi (Modo STA - Solo redes de 2.4 GHz)
#define WIFI_SSID             "TU_RED_WIFI_2.4GHZ"
#define WIFI_PASSWORD         "TU_CONTRASENA_WIFI"
#define WIFI_RECONNECT_MS     5000     // Intervalo de reintento de conexión Wi-Fi

// 2. Broker MQTT (EMQX sobre el anfitrión Windows / Docker)
// IMPORTANTE: NO usar "localhost" ni "127.0.0.1". Usar la IPv4 LAN de su PC (ej: 192.168.1.50)
#define MQTT_BROKER_HOST      "192.168.1.100"  // Reemplazar con la IPv4 de ipconfig
#define MQTT_BROKER_PORT      1883
#define MQTT_CLIENT_ID        "ESP32_FISICO_UNT"

// Autenticación MQTT (Por defecto vacíos para EMQX sin plugin MySQL activo;
// si el equipo activa autenticación MySQL en EMQX, colocar usuario y clave aquí)
#define MQTT_USER             ""
#define MQTT_PASSWORD         ""

// 3. Catálogo Ciberfísico y Tópicos
#define DEVICE_ID             "ESP32_FISICO_UNT"
#define DEVICE_LOCATION       "Cisterna Hogar"
#define NODE_ORIGIN           "PHYSICAL_REAL"

#define TOPIC_TELEMETRY       "cistern/ESP32_FISICO_UNT/telemetry"
#define TOPIC_COMMANDS        "cistern/ESP32_FISICO_UNT/commands"

// 4. Parámetros de Muestreo y Transmisión
#define DEFAULT_INTERVAL_SEC  5        // Intervalo de muestreo nominal en segundos
#define MIN_INTERVAL_SEC      1        // Límite mínimo para aceleración dinámica
#define MAX_INTERVAL_SEC      60       // Límite máximo de muestreo

// 5. Configuración de Hardware y Pines
#define PIN_TURBIDEZ_ADC      34       // GPIO 34 (ADC1_CH6 - Solo entrada, sin pullup interno)
#define PIN_DS18B20_DATA      4        // GPIO 4 (1-Wire datos con resistencia 4.7k a 3.3V)

// 6. Divisor de Tensión del Sensor de Turbidez TS-300B
// Salida analógica AO del sensor TS-300B (0 - 5.0 V)
// Dos resistencias de 10k en serie hacia ADC = 20 kΩ (R1)
// Resistencia desde ADC hacia GND = 20 kΩ (R2)
// Factor de atenuación: R2 / (R1 + R2) = 20 / (20 + 20) = 0.5
// Si en su prototipo usó R1=10k y R2=20k, ajuste los valores aquí:
#define DIVISOR_R1_OHMS       20000.0  // 2x 10k en serie = 20k
#define DIVISOR_R2_OHMS       20000.0  // 1x 20k hacia GND = 20k

// 7. Sincronización Horaria NTP
#define NTP_SERVER_1          "pool.ntp.org"
#define NTP_SERVER_2          "time.google.com"
#define GMT_OFFSET_SEC        (-5 * 3600)  // Perú UTC-5 (-18000 segundos)
#define DAYLIGHT_OFFSET_SEC   0            // Sin horario de verano

#endif // CONFIG_H
