# ARCHIVO: env.template (Plantilla de Variables de Entorno)
# INSTRUCCIÓN: Copie este archivo a '.env' fuera de control de versiones y complete los valores.
# =============================================================================

# 1. Base de Datos MySQL (Conexión interna entre contenedores)
DB_HOST=mysql_server
DB_PORT=3306
DB_NAME=emqx_db

# 2. Cuenta MySQL de Solo Lectura para el Broker EMQX (Principio de Mínimo Privilegio)
EMQX_RO_DB_USER=emqx_ro_user
EMQX_RO_DB_PASS=CAMBIAR_POR_CONTRASENA_ROBUSTA

# 3. Credenciales de Clientes MQTT (Para inserción en tabla mqtt_user)
MQTT_USER_PUB=web_pub_daniel
MQTT_PASS_PUB=CAMBIAR_POR_CLAVE_PUBLICADOR

MQTT_USER_SUB=web_sub_daniel
MQTT_PASS_SUB=CAMBIAR_POR_CLAVE_SUSCRIPTOR

MQTT_USER_NODES=esp32_nodes
MQTT_PASS_NODES=CAMBIAR_POR_CLAVE_NODOS_SIMULADOS

MQTT_USER_BACKEND=backend_rules
MQTT_PASS_BACKEND=CAMBIAR_POR_CLAVE_BACKEND_REGLAS

# 4. Parámetros del Broker EMQX
EMQX_HOST=localhost
EMQX_WS_PORT=8083
EMQX_TCP_PORT=1883
